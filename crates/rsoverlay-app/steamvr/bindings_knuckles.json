{
  "controller_type": "knuckles",
  "name": "RSOverlay defaults",
  "description": "Trigger click, grip squeeze grab, stick scroll/push/scale, trackpad press down / up = right / middle click modifier, double-press to show the dashboard",
  "bindings": {
    "/actions/rsoverlay": {
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/rsoverlay/in/click"
            },
            "pull": {
              "output": "/actions/rsoverlay/in/triggerpull"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/rsoverlay/in/click"
            },
            "pull": {
              "output": "/actions/rsoverlay/in/triggerpull"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "grab",
          "inputs": {
            "grab": {
              "output": "/actions/rsoverlay/in/grab"
            }
          },
          "parameters": {
            "force_hold_threshold": "0.35",
            "force_release_threshold": "0.2",
            "value_hold_threshold": "1.35",
            "value_release_threshold": "1.2"
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "grab",
          "inputs": {
            "grab": {
              "output": "/actions/rsoverlay/in/grab"
            }
          },
          "parameters": {
            "force_hold_threshold": "0.35",
            "force_release_threshold": "0.2",
            "value_hold_threshold": "1.35",
            "value_release_threshold": "1.2"
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/rsoverlay/in/stick"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/rsoverlay/in/stick"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "dpad",
          "inputs": {
            "north": {
              "output": "/actions/rsoverlay/in/middleclickmodifier"
            },
            "south": {
              "output": "/actions/rsoverlay/in/rightclickmodifier"
            }
          },
          "parameters": {
            "sub_mode": "click"
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "dpad",
          "inputs": {
            "north": {
              "output": "/actions/rsoverlay/in/middleclickmodifier"
            },
            "south": {
              "output": "/actions/rsoverlay/in/rightclickmodifier"
            }
          },
          "parameters": {
            "sub_mode": "click"
          }
        },
        {
          "path": "/user/hand/left/input/a",
          "mode": "button",
          "inputs": {
            "double": {
              "output": "/actions/rsoverlay/in/toggleeditmode"
            }
          }
        }
      ],
      "haptics": [
        {
          "output": "/actions/rsoverlay/out/haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/rsoverlay/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "poses": [
        {
          "output": "/actions/rsoverlay/in/pointer",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/rsoverlay/in/pointer",
          "path": "/user/hand/right/pose/tip"
        }
      ]
    }
  }
}